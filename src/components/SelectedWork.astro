---
import { featuredProjects, statusLabels, statusTone } from "../data/projects";
import { withBase } from "../data/site";
---

<section id="work" class="section section--calm work" aria-labelledby="work-title">
  <div class="container">
    <h2 id="work-title" class="eyebrow"><span class="num">02</span> / Selected work</h2>

    {featuredProjects.map((project) => (
      <article class="feature" aria-labelledby={`feature-${project.slug}`}>
        <div class="feature-copy">
          <p class="feature-index">
            <span class="feature-ring" aria-hidden="true"></span>
            <span class="feature-num">{project.number}</span>
            <span class="feature-slash" aria-hidden="true">/</span>
            <span class="feature-name">{project.name}</span>
          </p>

          <p class={`feature-status status status--${statusTone[project.status]}`}>
            {statusLabels[project.status]}
          </p>

          {project.subtitle && (
            <h3 id={`feature-${project.slug}`} class="feature-title">{project.subtitle}</h3>
          )}
          <p class="feature-desc">{project.description}</p>

          <hr class="feature-rule" />

          <dl class="feature-meta">
            <div>
              <dt class="mono">Key technologies</dt>
              <dd>
                <ul role="list" class="feature-tags">
                  {project.technologies.map((tech) => <li class="tag">{tech}</li>)}
                </ul>
              </dd>
            </div>
            {project.skills && (
              <div>
                <dt class="mono">Skills demonstrated</dt>
                <dd>
                  <ul role="list" class="feature-skills">
                    {project.skills.map((skill) => <li>{skill}</li>)}
                  </ul>
                </dd>
              </div>
            )}
          </dl>

          <div class="feature-actions">
            {project.caseStudyUrl && (
              <a class="btn btn--primary" href={project.caseStudyUrl}>
                View case study <span aria-hidden="true">→</span>
              </a>
            )}
            {project.liveUrl && (
              <a
                class={project.caseStudyUrl ? "btn" : "btn btn--primary"}
                href={project.liveUrl}
                target="_blank"
                rel="noopener"
              >
                Launch app <span aria-hidden="true">↗</span>
                <span class="visually-hidden">(opens in a new tab)</span>
              </a>
            )}
            {project.githubUrl && (
              <a class="btn" href={project.githubUrl} target="_blank" rel="noopener">
                GitHub <span aria-hidden="true">↗</span>
                <span class="visually-hidden">(opens in a new tab)</span>
              </a>
            )}
          </div>
        </div>

        {project.heroImage && (
          <figure class="feature-media">
            <div class="product-frame">
              <img
                src={withBase(project.heroImage)}
                srcset={`${withBase(project.heroImage.replace(".webp", "-960.webp"))} 900w, ${withBase(project.heroImage)} 1500w`}
                sizes="(min-width: 1024px) 58vw, 100vw"
                width="1500"
                height="1000"
                alt={project.heroImageAlt ?? ""}
                loading="lazy"
                decoding="async"
              />
            </div>
            <figcaption class="mono">{project.name} · live interface, selected-event view</figcaption>
          </figure>
        )}
      </article>
    ))}
  </div>
</section>

<style>
  .feature {
    display: grid;
    gap: var(--space-2xl);
    margin-top: clamp(var(--space-2xl), 4vw, 3.5rem);
    align-items: center;
  }

  .feature-index {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: clamp(2.25rem, 4vw, 3.5rem);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .feature-ring {
    flex: none;
    position: relative;
    width: 0.72em;
    height: 0.72em;
    margin-right: 0.2em;
    border: 1.5px solid var(--text-secondary);
    border-radius: 50%;
  }

  .feature-ring::after {
    content: "";
    position: absolute;
    inset: 30%;
    border-radius: 50%;
    background: var(--artifact);
  }

  .feature-num {
    color: var(--artifact);
    font-weight: 400;
  }

  .feature-slash {
    color: var(--artifact);
    font-weight: 300;
    opacity: 0.7;
  }

  .feature-name {
    text-transform: uppercase;
  }

  .feature-status {
    margin-top: var(--space-lg);
    padding: 0.4rem 0.75rem;
    border: 1px solid var(--signal-soft);
    border-radius: var(--radius-sm);
    background: rgba(94, 216, 255, 0.06);
  }

  .feature-title {
    margin-top: var(--space-lg);
    font-size: clamp(1.625rem, 2.4vw, 2.25rem);
  }

  .feature-desc {
    margin-top: var(--space-md);
    max-width: 34rem;
    color: var(--text-secondary);
    font-size: clamp(var(--text-base), 1.25vw, 1.125rem);
  }

  .feature-rule {
    width: 2.75rem;
    margin-block: var(--space-xl);
    border: 0;
    border-top: 1px solid var(--artifact);
  }

  .feature-meta {
    display: grid;
    gap: var(--space-xl);
  }

  .feature-meta dt {
    color: var(--text-muted);
    letter-spacing: 0.2em;
  }

  .feature-meta dd {
    margin: var(--space-sm) 0 0;
  }

  .feature-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .feature-skills {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, max-content));
    gap: 0.4rem 2rem;
    color: var(--text-secondary);
    font-size: var(--text-sm);
  }

  .feature-skills li {
    display: flex;
    gap: 0.6rem;
  }

  .feature-skills li::before {
    content: "→";
    color: var(--signal);
  }

  .feature-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
    margin-top: var(--space-2xl);
  }

  .feature-media {
    min-width: 0;
  }

  .product-frame {
    overflow: hidden;
    border: 1px solid var(--border-default);
    border-radius: var(--radius-md);
    background: var(--aether-void);
    box-shadow: 0 30px 60px -30px rgba(0, 0, 0, 0.8);
    transition:
      border-color var(--motion-ui) var(--ease-out),
      transform var(--motion-ui) var(--ease-out);
  }

  .product-frame:hover {
    border-color: var(--border-strong);
  }

  .product-frame img {
    width: 100%;
    height: auto;
  }

  figcaption {
    margin-top: var(--space-sm);
    color: var(--text-muted);
    font-size: 0.6875rem;
  }

  @media (max-width: 479px) {
    .feature-skills {
      grid-template-columns: 1fr;
    }
  }

  @media (min-width: 1024px) {
    .feature {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: clamp(3rem, 5vw, 5rem);
    }
  }
</style>
