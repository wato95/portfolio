---
// Capability copy lives here so wording can change without touching markup.
const capabilities = [
  {
    title: "Data Pipelines",
    body: "Pipelines that ingest, validate and load large volumes of data every day, and land on time.",
    examples: [
      "Airflow-orchestrated batch, 150M+ rows a day",
      "Idempotent ingest and safe re-runs",
      "Vendor and REST API integrations",
    ],
    icon: "pipeline",
    tone: "signal",
  },
  {
    title: "Data Modelling & Warehousing",
    body: "Warehouse schemas designed around how the data is actually queried, so the fast path is the default.",
    examples: [
      "Redshift at 600TB, 300bn-row core table",
      "Layered raw → staging → production models in dbt",
      "Query tuning: daily batch 1.5 hrs → 35 min",
    ],
    icon: "layers",
    tone: "artifact",
  },
  {
    title: "Data Quality & Reliability",
    body: "Checks that catch a wrong number before anyone acts on it, and a record of what failed and why.",
    examples: [
      "Validation and outlier rules",
      "Quarantine rather than drop, with open issues tracked",
      "Tested code behind CI (pytest, GitLab CI, GitHub Actions)",
    ],
    icon: "shield",
    tone: "signal",
  },
  {
    title: "Data Products",
    body: "The layer people actually use: agreed metrics, dashboards and apps built on the pipeline.",
    examples: [
      "Metric definitions teams self-serve from",
      "Tableau dashboards and Streamlit apps",
      "Static-first browser apps (DuckDB-Wasm, React)",
    ],
    icon: "dashboard",
    tone: "artifact",
  },
];

// pathLength="1" lets CSS draw any icon's strokes with one dash rule.
const drawable = (svg: string) => svg.replace(/<(path|rect|ellipse|circle)/g, '<$1 pathLength="1"');

const icons: Record<string, string> = {
  // 01 · Data Pipelines: two stages joined by a connector
  pipeline:
    '<rect x="4" y="4" width="9.5" height="9.5" rx="2"/><rect x="18.5" y="18.5" width="9.5" height="9.5" rx="2"/><path d="M8.75 13.5v7.25a2.5 2.5 0 0 0 2.5 2.5h7.25"/>',
  // 02 · Data Modelling & Warehousing: raw → staging → production
  layers: '<path d="M16 4 4 10.5l12 6.5 12-6.5zM4 16l12 6.5L28 16M4 21.5 16 28l12-6.5"/>',
  // 03 · Data Quality & Reliability
  shield: '<path d="M16 4 7 8v6.5c0 6 4 10.5 9 13.5 5-3 9-7.5 9-13.5V8zM12 16l2.75 2.75 5.5-5.5"/>',
  // 04 · Data Products
  dashboard:
    '<rect x="4" y="4" width="10" height="12" rx="2"/><rect x="18" y="4" width="10" height="7" rx="2"/><rect x="18" y="15" width="10" height="13" rx="2"/><rect x="4" y="20" width="10" height="8" rx="2"/>',
};
---

<section id="capabilities" class="section section--calm capabilities" aria-labelledby="capabilities-title">
  <!-- Sequence: annotation → heading → 01 → 02 → 03 → 04 (see --step). -->
  <div class="container" data-reveal-group>
    <div class="section-head">
      <p class="annotation" data-reveal-step style="--step: 0" aria-hidden="true">the work, not the logos ↘</p>
      <p class="eyebrow" data-reveal-step style="--step: 0"><span class="num">04</span> / What I build</p>
      <h2 id="capabilities-title" class="section-title" data-reveal-step style="--step: 1">
        I build the data platforms people <span class="accent">make decisions on.</span>
      </h2>
      <p class="lede" data-reveal-step style="--step: 1">
        Pipelines, warehouses and quality checks at scale, and the products that sit on top of them
      </p>
    </div>

    <ol class="cap-grid" role="list">
      {capabilities.map((cap, i) => (
        <li class="cap" data-reveal-step style={`--step: ${i + 2}`}>
          <article>
            <header class="cap-head">
              <svg class={`cap-icon cap-icon--${cap.tone}`} viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" stroke-linecap="round" aria-hidden="true" set:html={drawable(icons[cap.icon])} />
              <span class="cap-line" aria-hidden="true"></span>
              <span class="cap-num mono">0{i + 1}</span>
            </header>
            <h3 class="cap-title">{cap.title}</h3>
            <p class="cap-body">{cap.body}</p>
            <p class="cap-label mono">Examples</p>
            <ul role="list" class="cap-examples">
              {cap.examples.map((example) => <li>{example}</li>)}
            </ul>
          </article>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .section-head {
    position: relative;
  }

  /* The one handwritten-style note on the site (spec §5.3). */
  .annotation {
    position: absolute;
    top: -0.35rem;
    right: 0;
    font-family: var(--font-editorial);
    font-style: italic;
    font-size: clamp(1.125rem, 1.6vw, 1.375rem);
    color: var(--artifact);
    transform: rotate(-3deg);
    display: none;
  }

  .cap-grid {
    display: grid;
    gap: var(--space-md);
  }

  .cap article {
    height: 100%;
    display: flex;
    flex-direction: column;
    padding: clamp(1.5rem, 2.2vw, 2rem);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-md);
    background: rgba(13, 20, 32, 0.45);
    transition: border-color var(--motion-ui) var(--ease-out);
  }

  .cap article:hover {
    border-color: var(--border-strong);
  }

  .cap-head {
    display: flex;
    align-items: center;
    gap: var(--space-md);
  }

  .cap-icon {
    flex: none;
    width: 2.5rem;
    height: 2.5rem;
  }

  .cap-icon--signal {
    color: var(--signal);
  }

  .cap-icon--artifact {
    color: var(--artifact);
  }

  .cap-line {
    flex: 1;
    height: 1px;
    background: var(--border-default);
    transform-origin: left;
  }

  /* Once a card is in: its icon strokes draw, then the rule extends. */
  :global(.js-reveal) .cap-icon :global(*) {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    transition: stroke-dashoffset 1s var(--ease-out);
    transition-delay: calc(var(--step) * 110ms + 250ms);
  }

  :global(.js-reveal) .cap-line {
    transform: scaleX(0);
    transition: transform var(--motion-slow) var(--ease-out);
    transition-delay: calc(var(--step) * 110ms + 350ms);
  }

  .is-visible .cap-icon :global(*) {
    stroke-dashoffset: 0;
  }

  .is-visible .cap-line {
    transform: none;
  }

  .cap-num {
    color: var(--artifact);
    letter-spacing: 0.08em;
  }

  .cap-title {
    margin-top: var(--space-xl);
    font-size: var(--text-xl);
  }

  .cap-body {
    flex-grow: 1; /* fallback alignment where subgrid is unsupported */
    margin-top: var(--space-sm);
    color: var(--text-secondary);
    font-size: 0.9375rem;
    padding-bottom: var(--space-lg);
    border-bottom: 1px solid var(--border-subtle);
  }

  .cap-label {
    margin-top: var(--space-lg);
    color: var(--text-muted);
    letter-spacing: 0.2em;
  }

  .cap-examples {
    display: grid;
    align-content: start;
    gap: 0.55rem;
    margin-top: var(--space-md);
    font-size: var(--text-sm);
    color: var(--text-secondary);
  }

  .cap-examples li {
    display: flex;
    gap: 0.75rem;
  }

  .cap-examples li::before {
    content: "→";
    color: var(--signal);
  }

  /* Cards share row tracks, so titles, dividers and examples line up across a row. */
  @supports (grid-template-rows: subgrid) {
    .cap,
    .cap article {
      display: grid;
      grid-row: span 5;
      grid-template-rows: subgrid;
      row-gap: 0;
    }

    .cap article {
      grid-row: 1 / -1;
    }
  }

  @media (min-width: 720px) {
    .cap-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .annotation {
      display: block;
    }
  }

  @media (min-width: 1280px) {
    .cap-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
</style>
