---
import { site } from "../data/site";

const links = [
  { href: "#work", label: "Work" },
  { href: "#about", label: "About" },
  { href: "#projects", label: "Projects" },
  { href: "#contact", label: "Contact" },
];
---

<header class="site-header">
  <div class="header-inner">
    <a class="mark" href="#top" aria-label={`${site.name} — back to top`}>
      <span class="mark-cross" aria-hidden="true"></span>
      <span class="mark-text" aria-hidden="true">
        <span class="mark-name">Aether</span>
        <span class="mark-sub">Data / Systems / Maps</span>
      </span>
    </a>

    <nav class="nav" aria-label="Primary">
      <ul role="list">
        {links.map((link) => (
          <li><a href={link.href}>{link.label}</a></li>
        ))}
        {site.githubUrl && (
          <li>
            <a href={site.githubUrl} rel="me noopener" target="_blank">
              GitHub <span aria-hidden="true">↗</span>
              <span class="visually-hidden">(opens in a new tab)</span>
            </a>
          </li>
        )}
      </ul>
    </nav>

    <p class="coords" aria-hidden="true">
      51.5074° N<br />0.1278° W
    </p>
  </div>
</header>

<style>
  .site-header {
    position: absolute;
    inset: 0 0 auto;
    z-index: 10;
  }

  .header-inner {
    display: grid;
    grid-template-columns: 1fr;
    align-items: center;
    gap: var(--space-md);
    padding: var(--space-lg) var(--gutter);
  }

  /* Identity mark: small crosshair + "AETHER / DATA / SYSTEMS / MAPS" */
  .mark {
    display: none;
    align-items: flex-start;
    gap: var(--space-sm);
    justify-self: start;
  }

  .mark-cross {
    position: relative;
    width: 1.75rem;
    height: 1.75rem;
    margin-top: -0.4rem;
  }

  .mark-cross::before,
  .mark-cross::after {
    content: "";
    position: absolute;
    background: var(--border-strong);
  }

  .mark-cross::before {
    left: 50%;
    top: 0;
    bottom: 0;
    width: 1px;
  }

  .mark-cross::after {
    top: 50%;
    left: 0;
    right: 0;
    height: 1px;
  }

  .mark-text {
    display: grid;
    gap: 0.2rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    line-height: 1.3;
  }

  .mark-name {
    color: var(--artifact);
    letter-spacing: 0.32em;
  }

  .mark-sub {
    color: var(--text-muted);
    padding-top: 0.2rem;
    border-top: 1px solid var(--border-subtle);
  }

  .nav ul {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.25rem 1.25rem;
  }

  .nav a {
    position: relative;
    display: inline-block;
    padding: 0.5rem 0.125rem;
    font-size: var(--text-sm);
    color: var(--text-secondary);
    transition: color var(--motion-ui) var(--ease-out);
  }

  .nav a::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0.1rem;
    height: 1px;
    background: var(--signal);
    transform: scaleX(0);
    transition: transform var(--motion-ui) var(--ease-out);
  }

  .nav a:hover {
    color: var(--text-primary);
  }

  .nav a:hover::after {
    transform: scaleX(1);
  }

  .coords {
    display: none;
    justify-self: end;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    line-height: 1.6;
    color: var(--text-muted);
  }

  @media (min-width: 720px) {
    .nav ul {
      gap: 0.25rem 2.25rem;
    }

    .nav a {
      font-size: 0.9375rem;
    }
  }

  @media (min-width: 1024px) {
    .header-inner {
      grid-template-columns: 1fr auto 1fr;
      padding-block: var(--space-xl);
    }

    .mark,
    .coords {
      display: flex;
    }
  }
</style>
