---
import { pipeline } from "../data/pipeline";

const { stages } = pipeline;
const activeIndex = stages.findIndex((stage) => stage.id === pipeline.defaultStage);

// 24×24 line icons, stroke = currentColor.
const icons: Record<string, string> = {
  source:
    '<circle cx="12" cy="12" r="8.5"/><path d="M3.5 12h17M12 3.5c2.4 2.3 3.6 5.1 3.6 8.5s-1.2 6.2-3.6 8.5M12 3.5C9.6 5.8 8.4 8.6 8.4 12s1.2 6.2 3.6 8.5"/>',
  ingest: '<path d="M12 3.5v10.5M7.5 9.5 12 14l4.5-4.5M4 15.5v3a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-3"/>',
  validate: '<circle cx="12" cy="12" r="8.5"/><path d="m8.2 12.2 2.6 2.6 5-5.3"/>',
  persist:
    '<ellipse cx="12" cy="6" rx="7.5" ry="2.8"/><path d="M4.5 6v12c0 1.5 3.4 2.8 7.5 2.8s7.5-1.3 7.5-2.8V6M4.5 12c0 1.5 3.4 2.8 7.5 2.8s7.5-1.3 7.5-2.8"/>',
  transform: '<path d="m12 3.5 8.5 4.3-8.5 4.3-8.5-4.3zM3.5 12l8.5 4.3 8.5-4.3M3.5 16.2l8.5 4.3 8.5-4.3"/>',
  serve: '<path d="m12 3 8 4.5v9L12 21l-8-4.5v-9zM4 7.5l8 4.5 8-4.5M12 12v9"/>',
  interface: '<rect x="3.5" y="4.5" width="17" height="12.5" rx="1.8"/><path d="M8.5 20.5h7M3.5 8.5h17"/>',
};

const formatUtc = (iso: string) =>
  new Date(iso).toISOString().replace("T", " ").slice(0, 16) + " UTC";

const barWidth = (value: number, items: { value: number }[]) =>
  `${(value / Math.max(1, ...items.map((item) => item.value))) * 100}%`;
---

<section id="pipeline" class="section section--calm pipeline" aria-labelledby="pipeline-title">
  <div class="container">
    <div class="section-head" data-reveal>
      <p class="eyebrow"><span class="num">03</span> / Under the interface</p>
      <h2 id="pipeline-title" class="section-title">
        From raw data to <span class="accent">real products</span>
      </h2>
      <p class="lede">
        A walkthrough of {pipeline.system}: a modular pipeline that ingests, validates, transforms
        and serves real-world data for interactive products and analysis.
      </p>
    </div>

    <!--
      Interaction lives in src/scripts/pipeline.ts. Without JavaScript this is a
      stable static state: one active stage with its detail visible.
    -->
    <div class="pipeline-ui" data-pipeline data-default-stage={pipeline.defaultStage}>
      <div class="stages-scroll" data-pipeline-scroller data-reveal style="--step: 1">
        <ol class="stages" role="list" aria-label={`${pipeline.system} pipeline stages`}>
          {stages.map((stage, i) => (
            <li
              class:list={["stage", { "is-active": i === activeIndex, "is-done": i < activeIndex }]}
              data-stage={stage.id}
            >
              <button
                type="button"
                class="stage-btn"
                aria-controls="pipeline-detail"
                aria-label={`${stage.number} ${stage.name}: ${stage.summary}`}
                aria-current={i === activeIndex ? "step" : undefined}
                data-stage-button={stage.id}
              >
                <span class="stage-node">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons[stage.id]} />
                </span>
                <span class="stage-num mono">{stage.number}</span>
                <span class="stage-name mono">{stage.name}</span>
                <span class="stage-summary">{stage.summary}</span>
              </button>
            </li>
          ))}
        </ol>
      </div>

      <div id="pipeline-detail" class="detail panel" data-reveal style="--step: 2">
        <span class="playback-bar" aria-hidden="true" data-playback-bar><span></span></span>

        <!-- All stages share one grid cell, so switching never shifts the layout. -->
        <div class="detail-stack">
          {stages.map((stage, i) => (
            <div class="detail-body" data-stage-detail={stage.id} hidden={i !== activeIndex}>
              <div class="detail-intro">
                <p class="detail-label mono">Current stage</p>
                <p class="detail-id">
                  <span class="detail-num">{stage.number}</span>
                  <span class="detail-slash" aria-hidden="true">/</span>
                  {stage.name}
                </p>
                <h3 class="detail-title">{stage.title}</h3>
                <p class="detail-text">{stage.explanation}</p>
              </div>

              <dl class="detail-metrics">
                {stage.metrics.map((metric) => (
                  <div class="metric">
                    <dt>{metric.label}</dt>
                    <dd>{metric.value}</dd>
                    {metric.note && <p class="metric-note">{metric.note}</p>}
                  </div>
                ))}
              </dl>

              {stage.breakdown && (
                <div class="detail-breakdown">
                  <p class="detail-label mono">{stage.breakdown.title}</p>
                  <ul role="list">
                    {stage.breakdown.items.map((item) => (
                      <li>
                        <span class="bd-label">{item.label}</span>
                        <span class="bd-bar" aria-hidden="true">
                          <span style={`--w: ${barWidth(item.value, stage.breakdown!.items)}`}></span>
                        </span>
                        <span class="bd-value">{item.display ?? item.value}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              )}
            </div>
          ))}
        </div>

        <div class="detail-foot">
          <div class="playback" data-playback hidden>
            <p class="playback-status mono" data-playback-status></p>
            <button type="button" class="playback-toggle mono" data-playback-toggle hidden></button>
          </div>
          <div class="detail-meta">
            {pipeline.isFixture && (
              <p class="fixture-badge mono">Development fixture · illustrative values, not live telemetry</p>
            )}
            <p class="detail-through mono">
              Data through <time datetime={pipeline.dataThrough}>{formatUtc(pipeline.dataThrough)}</time>
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* ---- Stage rail ---- */
  .stages-scroll {
    margin-inline: calc(var(--gutter) * -1);
    padding-inline: var(--gutter);
    overflow-x: auto;
    scroll-snap-type: x proximity;
    scroll-padding-inline: var(--gutter);
    scrollbar-width: none;
  }

  .stages-scroll::-webkit-scrollbar {
    display: none;
  }

  .stages {
    --node: 4rem;
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(9.5rem, 1fr);
    padding-bottom: var(--space-sm);
  }

  .stage {
    position: relative;
    padding-right: var(--space-md);
    scroll-snap-align: start;
  }

  .stage-btn {
    display: grid;
    align-content: start;
    justify-items: start;
    gap: 0.35rem;
    width: 100%;
    padding: 0;
    text-align: left;
    border-radius: var(--radius-md);
  }

  .stage-btn:focus-visible {
    outline-offset: 6px;
  }

  /* Connector to the next stage: dashed and quiet by default. */
  .stage:not(:last-child)::after {
    content: "";
    position: absolute;
    top: calc(var(--node) / 2);
    left: calc(var(--node) + 0.75rem);
    right: 0.75rem;
    border-top: 1px dashed var(--border-strong);
  }

  /* Signal fill that travels along the connector once a stage is complete. */
  .stage:not(:last-child) .stage-btn::after {
    content: "";
    position: absolute;
    top: calc(var(--node) / 2);
    left: calc(var(--node) + 0.75rem);
    right: 0.75rem;
    height: 1px;
    background: rgba(94, 216, 255, 0.6);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--motion-slow) var(--ease-out);
  }

  /* Waypoint dot midway along each connector. */
  .stage:not(:last-child)::before {
    content: "";
    position: absolute;
    top: calc(var(--node) / 2 - 3px);
    left: calc((var(--node) + 100%) / 2);
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--text-muted);
    z-index: 1;
    transition: background-color var(--motion-medium) var(--ease-out);
  }

  .stage-node {
    display: grid;
    place-items: center;
    width: var(--node);
    height: var(--node);
    margin-bottom: var(--space-sm);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-md);
    background: var(--aether-surface);
    color: var(--text-secondary);
    transition:
      border-color var(--motion-medium) var(--ease-out),
      color var(--motion-medium) var(--ease-out),
      background-color var(--motion-medium) var(--ease-out),
      box-shadow var(--motion-medium) var(--ease-out);
  }

  .stage-btn:hover .stage-node {
    border-color: var(--border-strong);
    color: var(--text-primary);
  }

  .stage-node svg {
    width: 1.625rem;
    height: 1.625rem;
  }

  .stage-num {
    color: var(--artifact);
    letter-spacing: 0.08em;
  }

  .stage-name {
    color: var(--text-primary);
    letter-spacing: 0.18em;
  }

  .stage-summary {
    max-width: 13rem;
    color: var(--text-muted);
    font-size: var(--text-sm);
    line-height: 1.45;
    transition: color var(--motion-medium) var(--ease-out);
  }

  /* Prior route is illuminated. */
  .stage.is-done .stage-btn::after {
    transform: scaleX(1);
  }

  .stage.is-done::before {
    background: var(--signal);
  }

  .stage.is-done .stage-node {
    border-color: rgba(94, 216, 255, 0.35);
    color: #a9e9ff;
  }

  /* Active stage adopts Signal. */
  .stage.is-active .stage-node,
  .stage.is-active .stage-btn:hover .stage-node {
    border-color: var(--signal);
    color: var(--signal);
    background: rgba(94, 216, 255, 0.06);
    box-shadow:
      0 0 0 4px var(--signal-soft),
      0 0 28px var(--signal-glow);
  }

  .stage.is-active .stage-num {
    color: var(--signal);
  }

  .stage.is-active .stage-summary {
    color: var(--text-secondary);
  }

  /* ---- Detail panel ---- */
  /*
   * The detail layout responds to the panel's own width (container queries),
   * not the viewport, so its columns only split when their content fits.
   */
  .detail {
    position: relative;
    container: detail / inline-size;
    margin-top: var(--space-2xl);
    padding: clamp(1.25rem, 3vw, 2.5rem);
  }

  /* Progress of the current auto-advance interval, along the panel's top edge. */
  .playback-bar {
    position: absolute;
    top: 0;
    left: var(--radius-lg);
    right: var(--radius-lg);
    height: 1px;
  }

  .playback-bar span {
    display: block;
    height: 100%;
    background: linear-gradient(90deg, transparent, var(--signal));
    transform: scaleX(0);
    transform-origin: left;
  }

  .playback-bar.is-running span {
    animation: playback-fill var(--playback-ms, 5000ms) linear forwards;
  }

  @keyframes playback-fill {
    to {
      transform: scaleX(1);
    }
  }

  .detail-stack {
    display: grid;
  }

  .detail-body {
    grid-area: 1 / 1;
    display: grid;
    gap: var(--space-xl);
  }

  /* Hidden stages still size the stack, so the panel height never jumps. */
  .detail-body[hidden] {
    display: grid;
    visibility: hidden;
  }

  .detail-body.is-entering {
    animation: detail-in var(--motion-medium) var(--ease-out);
  }

  @keyframes detail-in {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
  }

  .detail-label {
    color: var(--text-muted);
    letter-spacing: 0.2em;
  }

  .detail-id {
    margin-top: var(--space-xs);
    font-size: var(--text-xl);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: -0.01em;
  }

  .detail-num {
    color: var(--artifact);
    font-weight: 400;
  }

  .detail-slash {
    margin-inline: 0.4rem;
    color: var(--artifact);
    opacity: 0.7;
  }

  .detail-title {
    margin-top: var(--space-md);
    font-size: var(--text-lg);
    color: var(--text-primary);
  }

  .detail-text {
    margin-top: var(--space-xs);
    max-width: 44ch;
    color: var(--text-secondary);
  }

  .detail-metrics {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-sm);
    align-content: start;
  }

  .metric {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: var(--space-lg);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    background: rgba(5, 7, 12, 0.35);
    container-type: inline-size;
  }

  .metric dd {
    order: -1; /* value reads first, label beneath */
    margin: 0;
    /* Scales with the tile so values like "99.98%" never outgrow it. */
    font-size: clamp(1.125rem, 24cqi, 1.75rem);
    font-weight: 500;
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.01em;
    line-height: 1.15;
  }

  .metric dt {
    color: var(--text-secondary);
    font-size: var(--text-sm);
  }

  .metric-note {
    color: var(--text-muted);
    font-size: var(--text-xs);
  }

  /* Rows share one set of content-sized columns (subgrid), so bars line up. */
  .detail-breakdown ul {
    display: grid;
    grid-template-columns: max-content minmax(2.5rem, 1fr) max-content;
    gap: 0.7rem var(--space-md);
    margin-top: var(--space-md);
  }

  .detail-breakdown li {
    display: grid;
    grid-column: 1 / -1;
    grid-template-columns: subgrid;
    align-items: center;
    font-size: var(--text-sm);
    color: var(--text-secondary);
  }

  @supports not (grid-template-columns: subgrid) {
    .detail-breakdown li {
      grid-template-columns: minmax(0, auto) minmax(2.5rem, 1fr) auto;
      column-gap: var(--space-md);
    }
  }

  .bd-bar {
    height: 4px;
    border-radius: var(--radius-pill);
    background: var(--border-subtle);
    overflow: hidden;
  }

  .bd-bar span {
    display: block;
    width: var(--w);
    height: 100%;
    border-radius: inherit;
    background: var(--artifact);
  }

  .bd-value {
    text-align: right;
    font-variant-numeric: tabular-nums;
    color: var(--text-primary);
  }

  .detail-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md) var(--space-xl);
    margin-top: var(--space-xl);
    padding-top: var(--space-lg);
    border-top: 1px solid var(--border-subtle);
  }

  .detail-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-xs) var(--space-xl);
  }

  /* Fixed footprint: status text changes with state but must never reflow the panel. */
  .playback {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    width: 100%;
    min-height: 2.25rem;
  }

  .playback[hidden] {
    display: none;
  }

  .playback-status {
    flex: 1;
    min-width: 0;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--text-secondary);
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
  }

  .playback-status::before {
    content: "";
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--text-muted);
  }

  .playback[data-state="playing"] .playback-status::before {
    background: var(--signal);
    box-shadow: 0 0 0 3px var(--signal-soft);
  }

  .playback-toggle {
    flex: none;
    min-height: 2.25rem;
    padding: 0.4rem 0.9rem;
    border: 1px solid var(--border-default);
    border-radius: var(--radius-pill);
    color: var(--text-primary);
    font-size: 0.6875rem;
    letter-spacing: 0.14em;
    transition:
      border-color var(--motion-ui) var(--ease-out),
      color var(--motion-ui) var(--ease-out);
  }

  .playback-toggle:hover {
    border-color: var(--signal);
    color: var(--signal);
  }

  .fixture-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--artifact);
    font-size: 0.6875rem;
  }

  .fixture-badge::before {
    content: "";
    width: 6px;
    height: 6px;
    border: 1px solid currentColor;
    transform: rotate(45deg);
  }

  .detail-through {
    color: var(--text-muted);
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
  }

  /* Narrow panel: metrics read as compact label/value rows. */
  @container detail (width < 36rem) {
    .metric {
      flex-direction: row;
      flex-wrap: wrap;
      align-items: baseline;
      justify-content: space-between;
      column-gap: var(--space-md);
      padding: 0.8rem 1rem;
    }

    .metric dd {
      order: 2;
      font-size: var(--text-xl);
    }

    .metric-note {
      order: 3;
      width: 100%;
    }
  }

  @container detail (width >= 36rem) {
    .detail-metrics {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    /* Room for the longest status label ("Holding while you read · 07 / 07"). */
    .playback {
      width: auto;
      justify-content: flex-start;
    }

    .playback-status {
      flex: none;
      min-width: 17.5rem;
    }
  }

  /* Intro beside metrics; breakdown spans beneath. */
  @container detail (width >= 52rem) {
    .detail-body {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.3fr);
      gap: var(--space-2xl);
    }

    .detail-breakdown {
      grid-column: 1 / -1;
    }
  }

  /* Three columns only once the breakdown has room for its labels and values. */
  @container detail (width >= 72rem) {
    .detail-body {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.35fr) minmax(0, 0.95fr);
    }

    .detail-breakdown {
      grid-column: auto;
      padding-left: var(--space-2xl);
      border-left: 1px solid var(--border-subtle);
    }
  }

  @media (min-width: 1024px) {
    .stages-scroll {
      margin-inline: 0;
      padding-inline: 0;
      overflow: visible;
    }

    .stages {
      grid-auto-columns: minmax(0, 1fr);
    }

  }

  @media (min-width: 1024px) and (max-width: 1279px) {
    .stages {
      --node: 3.5rem;
    }

    .stage-summary {
      font-size: var(--text-xs);
    }
  }
</style>

<script>
  import "../scripts/pipeline";
</script>
